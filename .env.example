# ─── DATABASE ────────────────────────────────────────────────────────────────
# pgvector/pgvector:pg16 Docker image (see docker-compose.yml)
DATABASE_URL=postgresql://wren:wren_dev@localhost:5432/wren

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CLERK AUTH ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── LLM (LiteLLM proxy) ─────────────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-dev-master-key

# ─── LLM PROVIDERS (passed to LiteLLM container) ─────────────────────────────
# These are used by LiteLLM to route to the actual providers.
# The application code never uses these directly — it calls LiteLLM only.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── FILE STORAGE ─────────────────────────────────────────────────────────────
# Dev: MinIO (local S3-compatible, see docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wren-dev
S3_ACCESS_KEY=minio_dev
S3_SECRET_KEY=minio_dev_secret
# Production: swap above for Cloudflare R2 credentials (ADR-011)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=wren-prod
# S3_ACCESS_KEY=<r2-access-key>
# S3_SECRET_KEY=<r2-secret-key>

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=                        # generate after starting n8n: Settings → API → Create API key

# ─── EMAIL (Dev: Mailhog) ─────────────────────────────────────────────────────
# Mailhog catches all outbound email in dev. View at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@wren.dev

# ─── APP ─────────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development

# ─── SEED ────────────────────────────────────────────────────────────────────
# Your Clerk user ID — run `pnpm db:seed` to create demo tenant with you as admin
# Find it in Clerk Dashboard → Users → your user → User ID
SEED_CLERK_USER_ID=user_...
