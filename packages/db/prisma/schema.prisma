generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Plan {
  TRIAL
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  DEPT_ADMIN
  USER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ─── TENANT ──────────────────────────────────────────────────────────────────

model Tenant {
  id               String   @id @default(cuid())
  clerkOrgId       String   @unique
  slug             String   @unique
  name             String
  plan             Plan     @default(TRIAL)
  /// JSON matching WhiteLabelConfig interface from @wren/types
  whiteLabelConfig Json?
  settings         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users               TenantUser[]
  agents              Agent[]
  knowledgeBases      KnowledgeBase[]
  prompts             Prompt[]
  chatSessions        ChatSession[]
  channelConfigs      ChannelConfig[]
  workflows           Workflow[]
  auditLogs           AuditLog[]
  tenantLocales       TenantLocale[]
  tenantPromptLocales TenantPromptLocale[] @relation("TenantPromptLocales")
}

// ─── USER ────────────────────────────────────────────────────────────────────

model TenantUser {
  id          String   @id @default(cuid())
  tenantId    String
  clerkUserId String
  role        UserRole @default(USER)
  department  String?
  preferredLocale String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clerkUserId])
  @@index([tenantId])
}

// ─── AGENT ───────────────────────────────────────────────────────────────────

model Agent {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  systemPrompt  String   @db.Text
  modelId       String   @default("gpt-4o")
  memorySize    Int      @default(20)
  maxTokens     Int      @default(4000)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  tools         String[]
  kbInstanceIds String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([tenantId])
}

// ─── KNOWLEDGE BASE ───────────────────────────────────────────────────────────

model KnowledgeBase {
  id        String   @id @default(cuid())
  tenantId  String   @unique          // one KB per tenant
  name      String   @default("Knowledge Base")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collections KbCollection[]
  documents   KbDocument[]
}

model KbCollection {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  parentId        String?       // nullable — supports one level of nesting
  parent          KbCollection?  @relation("CollectionChildren", fields: [parentId], references: [id])
  children        KbCollection[] @relation("CollectionChildren")
  name            String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  documents KbDocument[]

  @@index([knowledgeBaseId])
}

model KbDocument {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  collectionId    String?
  collection      KbCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  title        String
  fileName     String
  mimeType     String        // application/pdf | application/vnd.openxmlformats... | text/plain
  sizeBytes    Int
  storageKey   String        // S3 / local path
  source       String        @default("upload")       // upload | generated
  status       String        @default("processing")   // processing | ready | error
  errorMessage String?

  tags     String[] // auto-tagged taxonomy values
  summary  String?  // short LLM-generated summary
  metadata Json?    // arbitrary key-value (author, page count, etc.)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  chunks              KbChunk[]
  conversationLinks   ConversationDocument[]

  @@index([knowledgeBaseId])
  @@index([collectionId])
}

model KbChunk {
  id         String     @id @default(cuid())
  documentId String
  document   KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content    String                      @db.Text // raw text of this chunk
  tokenCount Int
  chunkIndex Int                                  // position within document
  pageNumber Int?                                 // for PDFs
  embedding  Unsupported("vector(768)")?          // nomic-embed-text output dimension

  createdAt DateTime @default(now())

  @@index([documentId])
}

// ─── PROMPTS ─────────────────────────────────────────────────────────────────

model Prompt {
  id                    String   @id @default(cuid())
  /// null = global/platform prompt; set = tenant-specific prompt
  tenantId              String?
  title                 String
  description           String?
  category              String
  department            String
  difficulty            String   @default("beginner")
  /// JSON Schema 7 — drives the adaptive form UI (ADR-016)
  formSchema            Json
  /// Handlebars template; vars come from form (ADR-016)
  promptTemplate        String   @db.Text
  isPublic              Boolean  @default(false)
  estimatedMinutesSaved Int?
  usageCount            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  locales TenantPromptLocale[]

  @@index([tenantId])
  @@index([department])
}

// ─── CHAT ────────────────────────────────────────────────────────────────────

model ChatSession {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  agentId     String
  channelType String
  channelId   String
  title       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent    Agent         @relation(fields: [agentId], references: [id])
  messages ChatMessage[]

  @@index([tenantId])
  @@index([userId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  tenantId   String
  role       MessageRole
  content    String      @db.Text
  toolCalls  Json?
  /// Rule 10 (CONTRIBUTING.md): tokenCount MUST always be populated on assistant messages
  tokenCount Int?
  modelId    String?
  /// Rule 10 (CONTRIBUTING.md): costUsd MUST always be populated on assistant messages
  costUsd    Float?
  createdAt  DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sessionId])
}

// ─── CHANNELS ────────────────────────────────────────────────────────────────

model ChannelConfig {
  id        String   @id @default(cuid())
  tenantId  String
  /// ChannelType from @wren/channels (teams|slack|whatsapp|telegram|email|webchat)
  channel   String
  config    Json
  isActive  Boolean  @default(true)
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId])
}

// ─── WORKFLOWS ───────────────────────────────────────────────────────────────

model Workflow {
  id          String    @id @default(cuid())
  tenantId    String
  /// n8n workflow ID (ADR-006)
  n8nId       String
  name        String
  description String?
  category    String?
  isActive    Boolean   @default(false)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

// ─── CHAT (Sprint 3) ──────────────────────────────────────────────────────────

model Conversation {
  id                   String                 @id @default(cuid())
  tenantId             String
  userId               String                 // Clerk user ID (app) or widget session key (webchat)
  channel              String                 @default("app")  // app | webchat
  title                String?                // auto-generated from first user turn (async)
  status               String                 @default("active")  // active | archived
  systemPromptSnapshot String?                @db.Text           // frozen at conversation start
  lastMessageAt        DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  messages     Message[]
  attachments  ConversationDocument[]

  @@index([tenantId, userId, lastMessageAt])
  @@index([tenantId, channel, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String       // system | user | assistant | tool
  content        String       @db.Text
  contentText    String?      @db.Text  // plain text for search indexing
  status         String       @default("complete")  // streaming | complete | error
  model          String?
  tokenInput     Int?
  tokenOutput    Int?
  errorMessage   String?
  citations      Json?        // [{ documentId, chunkId, label, pageNumber, excerpt }]
  metadata       Json?

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ConversationDocument {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  documentId     String
  document       KbDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, documentId])
  @@index([documentId])
}

model TenantChatSettings {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  systemPrompt   String?  @db.Text     // max 8000 chars enforced in API
  welcomeMessage String?  @db.Text
  launcherLabel  String?  @default("Chat with us")
  logoUrl        String?
  brandColor     String?  @default("#0F172A")
  accentColor    String?  @default("#22C55E")
  widgetTitle    String?  @default("Wren Assistant")
  allowedOrigins String[] // exact origins permitted to load WebChat iframe
  // Sprint 4: Auto-translate fields
  translationEnabled Boolean  @default(false)
  supportedLanguages String[] @default([])
  defaultLanguage    String   @default("en")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── TENANT LOCALE (Sprint 4b) ────────────────────────────────────────────────

model TenantLocale {
  id           String   @id @default(cuid())
  tenantId     String
  locale       String
  translations Json
  generatedAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, locale])
}

// ─── TENANT PROMPT LOCALE (Sprint 4c) ─────────────────────────────────────────

model TenantPromptLocale {
  id          String   @id @default(cuid())
  tenantId    String
  promptId    String
  locale      String
  title       String
  description String?
  generatedAt DateTime @default(now())
  stale       Boolean  @default(false)

  tenant Tenant @relation("TenantPromptLocales", fields: [tenantId], references: [id])
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([tenantId, promptId, locale])
  @@index([tenantId, locale])
}
