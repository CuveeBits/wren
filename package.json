{
  "name": "wren",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @wren/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @wren/db exec prisma db seed",
    "db:studio": "pnpm --filter @wren/db exec prisma studio",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.2.0",
    "turbo": "^2.10.10",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "ioredis": "5.9.3",
      "@xmldom/xmldom": "0.8.14",
      "fast-uri": "3.1.5",
      "postcss": "8.5.26",
      "flatted": "3.4.4",
      "picomatch": "4.0.5",
      "brace-expansion": "5.0.9",
      "esbuild": "0.28.2",
      "vite": "6.4.3"
    }
  }
}
